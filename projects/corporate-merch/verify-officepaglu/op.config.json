{
  "apps": {
    "web": {
      "dir": "corporate-merch-web",
      "port": 3000,
      "envFile": ".env.local",
      "healthPath": "/",
      "requiredEnv": ["NEXT_PUBLIC_API_URL", "NEXT_PUBLIC_SUPABASE_URL", "NEXT_PUBLIC_SUPABASE_ANON_KEY", "NEXT_PUBLIC_RAZORPAY_KEY_ID"],
      "checks": {
        "types": ["npx", "tsc", "--noEmit", "--pretty", "false"],
        "lint": ["npx", "eslint", "--format", "json", "."],
        "test": ["npm", "test", "--silent"]
      }
    },
    "api": {
      "dir": "corporate-merch-backend",
      "port": 8080,
      "envFile": ".env",
      "healthPath": "/health",
      "requiredEnv": ["SUPABASE_URL", "SUPABASE_SERVICE_KEY", "RAZORPAY_KEY_ID", "RAZORPAY_KEY_SECRET", "RAZORPAY_WEBHOOK_SECRET", "ORDER_TOKEN_SECRET"],
      "checks": {
        "types": ["npx", "tsc", "--noEmit", "--pretty", "false"],
        "test": ["npm", "test", "--silent"]
      }
    }
  },
  "browser": {
    "cdpPort": 9333,
    "baseUrl": "http://localhost:3000"
  }
}
